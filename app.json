{
  "expo": {
    "name": "Figo",
    "slug": "daterra",
    "scheme": "daterra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "appleTeamId": "9T837KG949",
      "bundleIdentifier": "com.brunobvaz.daterra.bench",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.brunobvaz.daterra.bench",
      "adaptiveIcon": {
        "backgroundColor": "#F7F2E7",
        "foregroundImage": "./assets/splash-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      ["expo-notifications", { "defaultChannel": "messages" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F2E7"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A DaTerra utiliza as tuas fotografias para escolheres uma imagem de perfil.",
          "microphonePermission": false
        }
      ],
      "./plugins/withSplashBackground"
    ],
    "extra": {
      "eas": {
        "projectId": "ab64ac0d-87e9-4ed5-8450-582c85f46a45"
      }
    },
    "owner": "brunobvaz"
  }
}
